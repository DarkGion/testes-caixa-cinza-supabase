{
  "info": {
    "name": "Testes de Autenticação",
    "description": "Aluno: Giovanni Leandro Lati | RA: 250870 | Curso: Análise e Desenvolvimento de Sistemas | Instituição: FACENS\n\nTestes de caixa cinza no endpoint POST /auth/v1/token?grant_type=password do Supabase Auth. Usa o environment 'Supabase - Testes' (base_url, api_key, anon_key, email, password). Não contém credenciais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CT-01 - Login valido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Somente confere se o Environment esta selecionado e com os dados de conexao.",
              "// Nao altera nenhuma variavel e nao bloqueia o envio por causa do conteudo do body.",
              "['base_url', 'api_key', 'anon_key'].forEach(function (v) {",
              "    if (!pm.environment.get(v)) {",
              "        throw new Error('Variavel de environment ausente: ' + v + '. Selecione o environment Supabase - Testes.');",
              "    }",
              "});",
              "['email', 'password'].forEach(function (v) {",
              "    if (!pm.environment.get(v)) {",
              "        throw new Error('Preencha a variavel ' + v + ' no Environment antes de executar.');",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tempo de resposta abaixo de 3000 ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "pm.test('Content-Type e application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Corpo da resposta e um JSON valido', function () {",
              "    pm.expect(function () { pm.response.json(); }).to.not.throw();",
              "});",
              "pm.test('Status HTTP e 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Estrutura JSON de sucesso (access_token, token_type, expires_in, refresh_token, user)', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('access_token').that.is.a('string').and.is.not.empty;",
              "    pm.expect(body).to.have.property('token_type');",
              "    pm.expect(body).to.have.property('expires_in').that.is.a('number');",
              "    pm.expect(body).to.have.property('refresh_token').that.is.a('string').and.is.not.empty;",
              "    pm.expect(body).to.have.property('user').that.is.an('object');",
              "});",
              "pm.test('access_token tem formato de JWT (3 partes)', function () {",
              "    pm.expect(pm.response.json().access_token.split('.')).to.have.lengthOf(3);",
              "});",
              "pm.test('token_type e bearer', function () {",
              "    pm.expect(pm.response.json().token_type.toLowerCase()).to.eql('bearer');",
              "});",
              "pm.test('Usuario retornado corresponde ao e-mail enviado', function () {",
              "    pm.expect(pm.response.json().user.email).to.eql(pm.environment.get('email'));",
              "});",
              "// Nenhum token e gravado em variavel nem exibido no console."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anon_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Credenciais validas do usuario de teste (variaveis {{email}} e {{password}}). Esperado: HTTP 200 com access_token."
      },
      "response": []
    },
    {
      "name": "CT-02 - Senha incorreta",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Somente confere se o Environment esta selecionado e com os dados de conexao.",
              "// Nao altera nenhuma variavel e nao bloqueia o envio por causa do conteudo do body.",
              "['base_url', 'api_key', 'anon_key'].forEach(function (v) {",
              "    if (!pm.environment.get(v)) {",
              "        throw new Error('Variavel de environment ausente: ' + v + '. Selecione o environment Supabase - Testes.');",
              "    }",
              "});",
              "if (!pm.environment.get('email')) {",
              "    throw new Error('Preencha a variavel email no Environment antes de executar.');",
              "}",
              "// Garante que a senha 'incorreta' do CT-02 realmente seja diferente da senha real.",
              "if (pm.environment.get('password') === 'SenhaIncorreta#2026') {",
              "    throw new Error('A senha real nao pode ser igual a senha incorreta usada no CT-02.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tempo de resposta abaixo de 3000 ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "pm.test('Content-Type e application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Corpo da resposta e um JSON valido', function () {",
              "    pm.expect(function () { pm.response.json(); }).to.not.throw();",
              "});",
              "pm.test('Status HTTP e erro de cliente (faixa 4xx, sem sucesso e sem erro de servidor)', function () {",
              "    pm.expect(pm.response.code).to.be.within(400, 499);",
              "});",
              "pm.test('Nao retorna access_token nem refresh_token', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.not.have.property('access_token');",
              "    pm.expect(body).to.not.have.property('refresh_token');",
              "});",
              "pm.test('Resposta traz uma mensagem de erro em texto', function () {",
              "    const body = pm.response.json();",
              "    const campos = ['msg', 'message', 'error_description', 'error'];",
              "    const achou = campos.some(function (c) {",
              "        return typeof body[c] === 'string' && body[c].length > 0;",
              "    });",
              "    pm.expect(achou, 'nenhum campo de mensagem encontrado (' + campos.join(', ') + ')').to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anon_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"SenhaIncorreta#2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Usuario EXISTENTE ({{email}}) com senha incorreta fixa. Esperado: falha de autenticacao (4xx) sem access_token. Status, error_code e mensagem exatos: registrar da execucao real."
      },
      "response": []
    },
